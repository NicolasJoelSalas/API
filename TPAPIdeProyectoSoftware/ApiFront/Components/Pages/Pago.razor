@page "/pago"
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

@rendermode InteractiveServer

<h3 class="title">Finalizar compra</h3>

<div class="payment-container">

    <!-- FORMULARIO -->
    <div class="payment-form">

        <h4>Datos de pago</h4>

        <div class="input-group">
            <label>Nombre en la tarjeta</label>
            <input type="text" @bind="cardName" />
        </div>

        <div class="input-group">
            <label>Número de tarjeta</label>
            <input type="text" @bind="cardNumber" />
        </div>

        <div class="row">
            <div class="input-group">
                <label>Vencimiento</label>
                <input type="text" @bind="expiry" />
            </div>

            <div class="input-group">
                <label>CVV</label>
                <input type="password" @bind="cvv" />
            </div>
        </div>

        <button class="pay-btn" @onclick="SimulatePayment" disabled="@isProcessing">
            @(isProcessing ? "Procesando..." : "Pagar ahora")
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="message">@message</p>
        }

        <button class="nav-btn" @onclick="GoBack">
            ← Volver
        </button>

    </div>

    <!-- RESUMEN -->
    <div class="payment-summary">

        <h4>Resumen</h4>

        @if (isLoadingSector)
        {
            <p>Cargando precios...</p>
        }
        else
        {
            <div class="summary-item">
                <span>Entradas (@seatCount)</span>
                <span>$@(seatCount * sectorPrice)</span>
            </div>

            <div class="summary-total">
                <span>Total</span>
                <span>$@(seatCount * sectorPrice)</span>
            </div>
        }

    </div>

</div>

@code {
    private List<string> seatIds = new();
    private int seatCount = 0;
    private int sectorId;
    private decimal sectorPrice;
    private List<Guid> reservationIds = new();

    private string cardName = "";
    private string cardNumber = "";
    private string expiry = "";
    private string cvv = "";
    private string message = "";
    private bool isLoadingSector = true;
    private bool isProcessing = false;

    protected override async Task OnParametersSetAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var reservationsParam = query["reservations"];
        var sectorParam = query["sectorId"];

        if (!string.IsNullOrWhiteSpace(reservationsParam))
        {
            reservationIds = reservationsParam
                .Split(',')
                .Select(Guid.Parse)
                .ToList();

            seatCount = reservationIds.Count; 
        }
        if (!string.IsNullOrWhiteSpace(sectorParam) && int.TryParse(sectorParam, out var id))
        {
            sectorId = id;
            await LoadSectorPrice();
        }
    }

    private async Task LoadSectorPrice()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("Api");

            var sector = await http.GetFromJsonAsync<SectorDto>($"api/sector/{sectorId}");

            if (sector != null)
                sectorPrice = sector.Price;
        }
        catch
        {
            sectorPrice = 0;
        }
        finally
        {
            isLoadingSector = false;
        }
    }

    private async Task SimulatePayment()
    {
        if (!reservationIds.Any())
        {
            message = "❌ No hay reservas para pagar";
            return;
        }


        isProcessing = true;
        message = "";

        try
        {
            var http = HttpClientFactory.CreateClient("Api");

            var dto = new ConfirmPaymentDto
            {
                ReservationIds = reservationIds
            };

            var response = await http.PostAsJsonAsync("api/Reservation/confirm-payment", dto);

            if (response.IsSuccessStatusCode)
            {
                message = "✅ Pago confirmado correctamente";

                // opcional: limpiar estado o redirigir
                reservationIds.Clear();
                seatCount = 0;

                // opcional PRO:
                // Nav.NavigateTo("/success");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"❌ {error}";
            }
        }
        catch
        {
            message = "❌ Error de conexión con el servidor";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    public class SectorDto
    {
        public int Id { get; set; }
        public decimal Price { get; set; }
    }

    public class ConfirmPaymentDto
    {
        public List<Guid> ReservationIds { get; set; } = new();
    }
}