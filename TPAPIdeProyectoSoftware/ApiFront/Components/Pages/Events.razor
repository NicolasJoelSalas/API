@page "/events"
@using ApiFront
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject UserSession Session

<h3 class="mb-4 text-center">🎟️ Eventos Disponibles</h3>

@if (lisevents == null)
{
    <div class="text-center mt-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>

        <p>Cargando eventos...</p>
    </div>
}
else if (!lisevents.Any())
{
    <p class="text-center">No hay eventos disponibles</p>
}
else
{
    <div class="event-list">

        @foreach (var item in PagedEvents)
        {
            <div class="event-card">

                <div class="event-title">
                    @item.Name
                </div>

                <button class="btn btn-primary btn-sm mt-2"
                        @onclick="() => GoToSectors(item.Id)">
                    Ver sectores
                </button>

            </div>
        }

    </div>
    <div class="d-flex justify-content-center align-items-center gap-3 mt-4">

        <button class="btn btn-secondary"
                disabled="@(currentPage == 1)"
                @onclick="PreviousPage">

            ← Anterior

        </button>

        <span>
            Página @currentPage de @TotalPages
        </span>

        <button class="btn btn-secondary"
                disabled="@(currentPage == TotalPages)"
                @onclick="NextPage">

            Siguiente →
        </button>

    </div>

    <button class="nav-btn" @onclick="GoBack">
        ← Volver
    </button>
}

@code {
    public static class ApiRoutes
    {
        public const string Events = "api/events";

        public static string EventSectors(int id)
            => $"/events/{id}/sectors";
    }

    private int currentPage = 1;
    private int pageSize = 4;
    private IEnumerable<EventDto> PagedEvents =>
    lisevents?
    .Skip((currentPage - 1) * pageSize)
    .Take(pageSize)
    ?? Enumerable.Empty<EventDto>();
    private int TotalPages =>
    (int)Math.Ceiling(
        (double)lisevents.Count / pageSize
    );

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
    private List<EventDto>? lisevents;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("Api");
            await Task.Delay(400);

            lisevents = await http.GetFromJsonAsync<List<EventDto>>
            (
            ApiRoutes.Events
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando eventos: {ex.Message}");
            lisevents = new List<EventDto>();
        }
    }

    private void GoToSectors(int id)
    {
        Console.WriteLine($"CLICK EVENTO ID: {id}");
        Nav.NavigateTo(ApiRoutes.EventSectors(id));
    }

    public class EventDto
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }
    private void NextPage()
    {
    if(currentPage < TotalPages)
        currentPage++;
}

private void PreviousPage()
{
    if(currentPage > 1)
        currentPage--;
}
    
}