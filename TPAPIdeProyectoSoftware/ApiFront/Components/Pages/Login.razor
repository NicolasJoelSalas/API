@page "/"
@using ApiFront
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject UserSession Session


<PageTitle>Home</PageTitle>

<div class="hero-video">
    <video autoplay muted loop playsinline class="bg-video">
        <source src="videos/m.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay">
        <h1>🎟️ TicketApp</h1>
        <p>Conciertos, eventos y experiencias en vivo</p>
    </div>
</div>

@if (!isLogged)
{
    <div class="login-modal">
        <div class="wrapper">

            <h1>Login</h1>

            <div class="input-box">
                <input @bind="loginRequest.Name" type="text" placeholder="Username" />
                <i class='bx bxs-user'></i>
            </div>

            <div class="input-box">
                <input @bind="loginRequest.PasswordHash" type="password" placeholder="Password" />
                <i class='bx bxs-lock-alt'></i>
            </div>

            <button class="btn" @onclick="Log_in">Login</button>

            <div class="register-link">
                <a class="bx bxs-user" href="/register">Registrarse</a>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p style="color:red">@errorMessage</p>
            }

        </div>
    </div>
}

@code {
    private bool isLogged = false;
    private string? errorMessage;

    private LoginRequest loginRequest = new();

    private async Task Log_in()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("Api");

            var response = await http.PostAsJsonAsync("api/users/login", loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

                Session.UserId = result.UserId;
                Session.Username = result.Username;

                isLogged = true;
                errorMessage = null;

                Nav.NavigateTo("/home");
            }
            else
            {
                var msg = await response.Content.ReadFromJsonAsync<ErrorResponse>();

                errorMessage = msg?.Message ?? "Error al iniciar sesión";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    public class LoginRequest
    {
        public string Name { get; set; } = "";
        public string PasswordHash { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Message { get; set; }
        public int UserId { get; set; }
        public string Username { get; set; }
    }

    public class ErrorResponse
    {
        public string Message { get; set; }
    }

    
}