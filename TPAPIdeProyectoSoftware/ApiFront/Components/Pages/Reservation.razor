@using ApiFront.Services
@page "/reservation/{SeatId:guid}"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject UserSession Session

<h3>Reservar Butaca</h3>

<p>Butaca seleccionada: @SeatId</p>
<button class="nav-btn" @onclick="GoBack">
    ← Volver
</button>
<button class="btn btn-success" @onclick="CreateReservation">
    Confirmar Reserva
</button>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
    [Parameter]
    public Guid SeatId { get; set; }

    private string message = "";

    private async Task CreateReservation()
    {
        var http = HttpClientFactory.CreateClient("Api");
        
        var dto = new
        {
            UserId = Session.UserId, // usuario logueado
            SeatId = SeatId
        };

        var response = await http.PostAsJsonAsync("api/Reservation", dto);

        if (response.IsSuccessStatusCode)
            message = "Reserva realizada correctamente";
        else
            message = "Error al reservar";
    }
}